{
  "name": "shytalk",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage.enabled",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tests/smoke && tsc --noEmit -p apps/web/scripts",
    "build:web": "astro build --root apps/web",
    "test:smoke": "playwright test -c tests/smoke",
    "test:phones": "node tests/phones/phone-smoke.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/noto-sans-thai": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@playwright/test": "1.65.1",
    "@shyden-labs/playwright-devices": ">=0.1.3",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "astro": "7.4.12",
    "eslint": "10.15.0",
    "imapflow": "2.11.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.1",
    "wrangler": "4.162.0"
  },
  "allowScripts": {
    "fsevents": false,
    "esbuild": false,
    "workerd": false
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.25",
    "@better-auth/utils": "0.5.1",
    "@simplewebauthn/browser": "13.3.0",
    "better-auth": "1.7.25",
    "better-call": "1.4.5",
    "jose": "6.2.17",
    "valibot": "1.5.0"
  }
}
