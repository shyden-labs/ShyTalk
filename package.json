{
  "name": "shytalk",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage.enabled",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tests/smoke",
    "build:web": "astro build --root apps/web",
    "test:smoke": "playwright test -c tests/smoke",
    "test:phones": "node tests/phones/phone-smoke.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "astro": "7.4.5",
    "eslint": "10.14.0",
    "imapflow": "2.11.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "allowScripts": {
    "fsevents": false,
    "esbuild": false,
    "workerd": false
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "dependencies": {
    "better-auth": "1.7.17",
    "jose": "6.2.15",
    "valibot": "1.5.0"
  }
}
