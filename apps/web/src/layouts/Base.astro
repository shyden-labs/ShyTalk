---
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
import { t, type Locale } from '../i18n/t.ts';

interface Props {
  locale: Locale;
  title: string;
}
const { locale, title } = Astro.props;
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-Hans' : locale}>
  <head>
    <meta charset="utf-8" />
    <!-- The on-screen keyboard resizes the page instead of panning over it (Android Chrome), so a form's next control
         stays reachable (shyden-labs/ShyTalk#189). -->
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{title === t(locale, 'site.name') ? title : `${title} · ${t(locale, 'site.name')}`}</title>
    <meta name="description" content={t(locale, 'site.tagline')} />
    <link rel="stylesheet" href="/styles/site.css" />
  </head>
  <body>
    <Menu locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
