---
import Base from '../layouts/Base.astro';
import { localePath, t, type Locale } from '../i18n/t.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Base locale={locale} title={t(locale, 'notFound.title')}>
  <h1>{t(locale, 'notFound.title')}</h1>
  <p>{t(locale, 'notFound.body')}</p>
  <p><a href={localePath(locale, '/')}>{t(locale, 'notFound.home')}</a></p>
</Base>
