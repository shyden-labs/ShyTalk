---
/**
 * A language's flag for the language menu (shyden-labs/ShyTalk#332), drawn inline at 3:2 so the CSP needs no image
 * source: decoration only, kept out of the accessible name, as the language's name sits beside it.
 */
import type { Locale } from '../i18n/t.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const NAMES: Record<Locale, string> = { en: 'gb', id: 'id', th: 'th', vi: 'vn', zh: 'cn' };
/** A five-pointed star of radius `r` centred on (x, y), pointing up. */
const star = (x: number, y: number, r: number): string =>
  Array.from({ length: 10 }, (_, i) => {
    const angle = (Math.PI / 5) * i - Math.PI / 2;
    const reach = i % 2 === 0 ? r : r * 0.382;
    return `${(x + reach * Math.cos(angle)).toFixed(2)},${(y + reach * Math.sin(angle)).toFixed(2)}`;
  }).join(' ');
---

<svg class="flag" data-flag={NAMES[locale]} viewBox="0 0 24 16" width="24" height="16" aria-hidden="true" role="presentation" focusable="false">
  {
    locale === 'en' && (
      <>
        <rect width="24" height="16" fill="#012169" />
        <path d="M0 0L24 16M24 0L0 16" stroke="#fff" stroke-width="3" />
        <path d="M0 0L24 16M24 0L0 16" stroke="#c8102e" stroke-width="1.2" />
        <path d="M12 0V16M0 8H24" stroke="#fff" stroke-width="5" />
        <path d="M12 0V16M0 8H24" stroke="#c8102e" stroke-width="3" />
      </>
    )
  }
  {
    locale === 'id' && (
      <>
        <rect width="24" height="16" fill="#fff" />
        <rect width="24" height="8" fill="#ce1126" />
      </>
    )
  }
  {
    locale === 'th' && (
      <>
        <rect width="24" height="16" fill="#a51931" />
        <rect y="2.67" width="24" height="10.66" fill="#f4f5f8" />
        <rect y="5.33" width="24" height="5.34" fill="#2d2a4a" />
      </>
    )
  }
  {
    locale === 'vi' && (
      <>
        <rect width="24" height="16" fill="#da251d" />
        <polygon points={star(12, 8, 4.8)} fill="#ffcd00" />
      </>
    )
  }
  {
    locale === 'zh' && (
      <>
        <rect width="24" height="16" fill="#ee1c25" />
        <polygon points={star(4, 4, 2.4)} fill="#ffff00" />
        <polygon points={star(8, 1.6, 0.8)} fill="#ffff00" />
        <polygon points={star(9.6, 3.2, 0.8)} fill="#ffff00" />
        <polygon points={star(9.6, 5.6, 0.8)} fill="#ffff00" />
        <polygon points={star(8, 7.2, 0.8)} fill="#ffff00" />
      </>
    )
  }
</svg>
