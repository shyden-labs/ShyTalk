---
import Base from '../layouts/Base.astro';
import { t, type Locale } from '../i18n/t.ts';
import { shydeskOrigin } from '../support.ts';
import wrangler from '../../../../workers/web/wrangler.json';

interface Props {
  locale: Locale;
  /**
   * `contact` asks for help; `ticket` opens the thread ShyDesk's emailed link names (`#t=<token>`); `appeal` opens the
   * appeal a punishment notice links to (`#appeal=<token>`, shyden-labs/ShyTalk#310).
   */
  view: 'contact' | 'ticket' | 'appeal';
  /**
   * On a language-free page, its path: the page moves to the visitor's language of that path, keeping the address's
   * query and fragment.
   */
  pickLanguage?: string;
}
const { locale, view, pickLanguage } = Astro.props;
const line = (key: string): string => t(locale, `support.${key}`);
const TITLES = { contact: 'title', ticket: 'ticketTitle', appeal: 'appealTitle' } as const;
const INTROS = { contact: 'intro', ticket: undefined, appeal: 'appealIntro' } as const;
const intro = INTROS[view];
// The ShyDesk of the environment this build is for, as the Worker's support policy names it (shyden-labs/ShyTalk#37).
const shydesk = shydeskOrigin(process.env.SITE_ENVIRONMENT, wrangler);
---

<Base locale={locale} title={line(TITLES[view])}>
  <h1>{line(TITLES[view])}</h1>
  {intro !== undefined && <p data-line={intro}>{line(intro)}</p>}
  <p data-line="englishForm">{line('englishForm')}</p>
  <noscript><p>{line('noScript')}</p></noscript>
  <shydesk-support
    product="shytalk"
    view={view}
    lang={locale}
    data-pick-language={pickLanguage}></shydesk-support>
  <script is:inline src={`${shydesk}/embed.js`} defer></script>
</Base>

<script>
  import { localePath } from '../i18n/t.ts';
  import { arrivedFromSite, browserLocale } from '../support.ts';

  const piece = document.querySelector<HTMLElement>('shydesk-support');

  // The ticket and appeal pages carry their token in the address (shyden-labs/ShyTalk#352): each language in the menu
  // opens that language's page with the same query and fragment, kept up to date if the fragment changes.
  if (piece !== null && piece.getAttribute('view') !== 'contact') {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('details.lang-switch a.entry')].map((link) => ({
      link,
      page: link.getAttribute('href') ?? '',
    }));
    const carry = (): void => {
      for (const { link, page } of links) link.setAttribute('href', `${page}${location.search}${location.hash}`);
    };
    carry();
    addEventListener('hashchange', carry);
  }

  // An emailed or notice link names one language-free address: move to the visitor's language, keeping its query and
  // token, unless the visitor came here from the site's own language menu, which is a choice of English.
  const path = piece?.dataset['pickLanguage'];
  if (piece !== null && path !== undefined) {
    const locale = browserLocale(navigator.languages);
    if (locale !== 'en' && !arrivedFromSite(document.referrer, location.origin)) {
      location.replace(`${localePath(locale, path)}${location.search}${location.hash}`);
    } else {
      piece.dataset['languageKept'] = '';
    }
  }
</script>
