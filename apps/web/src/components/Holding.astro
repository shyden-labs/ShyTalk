---
/**
 * The holding page production answers with until the full release (shyden-labs/ShyTalk#261), in ShyTalk's brand
 * (#273): a language switch, the icon, the name, "Coming soon", the tagline, and the floating hellos (no contact address, shyden-labs/ShyTalk#333). No
 * menu or footer, as nothing they would link to is released. The fonts are bundled from @fontsource and served from
 * the site itself, as the content security policy allows only the site's own address.
 */
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/800.css';
import '@fontsource/noto-sans/800.css';
import '@fontsource/noto-sans-sc/800.css';
import '@fontsource/noto-sans-thai/800.css';
import Base from '../layouts/Base.astro';
import Hellos from './Hellos.astro';
import { LANGUAGE_NAMES, LOCALES, langTag, t, type Locale } from '../i18n/t.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Base locale={locale} title={t(locale, 'site.name')} bare>
  <div class="holding">
    <header class="holding-top">
      <img class="holding-mark" src="/icons/icon-192.png" width="34" height="34" alt="" />
      <nav aria-label={t(locale, 'language.label')}>
        <ul>
          {
            LOCALES.map((other) => (
              <li>
                <a href={`/${other}/`} hreflang={langTag(other)} lang={langTag(other)} aria-current={other === locale ? 'page' : undefined}>
                  {LANGUAGE_NAMES[other]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <div class="holding-stage">
      <img class="brand-icon" src="/icons/icon-192.png" width="96" height="96" alt="" />
      <h1 class="wordmark">Shy<span>Talk</span></h1>
      <p class="badge">{t(locale, 'holding.comingSoon')}</p>
      <p class="tagline">{t(locale, 'site.tagline')}</p>
      <Hellos />
    </div>
  </div>
</Base>
