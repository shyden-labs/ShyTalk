---
/**
 * The holding page production answers with until the full release (shyden-labs/ShyTalk#261): what ShyTalk is, that
 * the app is being built, and the contact. No menu or footer, as nothing they would link to is released.
 */
import Base from '../layouts/Base.astro';
import { t, type Locale } from '../i18n/t.ts';
import { SUPPORT_EMAIL } from '../site.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Base locale={locale} title={t(locale, 'site.name')} bare>
  <h1>{t(locale, 'home.heading')}</h1>
  <p data-holding="intro">{t(locale, 'home.intro')}</p>
  <h2 data-holding="way">{t(locale, 'home.wayTitle')}</h2>
  <p data-holding="building">{t(locale, 'holding.building')}</p>
  <p>{t(locale, 'footer.contact')}: <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></p>
</Base>
