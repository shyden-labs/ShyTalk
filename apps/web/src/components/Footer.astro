---
import { t, type Locale } from '../i18n/t.ts';
import { LEGAL_DOCS, legalPath } from '../legal/legal.ts';
import { SUPPORT_EMAIL } from '../site.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<footer class="site-footer">
  <ul>
    {
      LEGAL_DOCS.map((doc) => (
        <li>
          <a data-legal={doc} href={legalPath(locale, doc)}>
            {t(locale, `footer.${doc}`)}
          </a>
        </li>
      ))
    }
    <li>{t(locale, 'footer.contact')}: <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></li>
  </ul>
</footer>
