---
import { localePath, t, type Locale } from '../i18n/t.ts';
import { LEGAL_DOCS, legalPath } from '../legal/legal.ts';
import { SUPPORT_PATH } from '../support.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<footer class="site-footer">
  <ul>
    {
      LEGAL_DOCS.map((doc) => (
        <li>
          <a data-legal={doc} href={legalPath(locale, doc)}>
            {t(locale, `footer.${doc}`)}
          </a>
        </li>
      ))
    }
    <li><a data-support href={localePath(locale, SUPPORT_PATH)}>{t(locale, 'footer.contact')}</a></li>
  </ul>
</footer>
