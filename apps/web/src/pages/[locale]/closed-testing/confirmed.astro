---
import ClosedTestingNote from '../../../components/ClosedTestingNote.astro';
import { LOCALES, type Locale } from '../../../i18n/t.ts';

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== 'en').map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
---

<ClosedTestingNote locale={locale} kind="confirmed" />
