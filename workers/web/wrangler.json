{
  "name": "shytalk-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "env": {
    "prod": {
      "name": "shytalk-web",
      "account_id": "debdf0b47ce2f7e5554e99c1f5d3a1e0",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "shytalk.app",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT_NAME": "prod",
        "SITE_ORIGIN": "https://shytalk.app",
        "GOOGLE_CLIENT_IDS": "415977447751-nu1hom2nn6dlg15gdh02de1kl3rm3onj.apps.googleusercontent.com,415977447751-s5v065q1pv58mjqp12bmosknv2g96ak1.apps.googleusercontent.com",
        "APPLE_AUDIENCES": "com.shyden.shytalk"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shytalk-prod",
          "migrations_dir": "../../migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "SIGN_IN_LIMIT",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    },
    "test": {
      "name": "shytalk-test",
      "account_id": "6a27c9ff4b4eefef2c46535449ea4f49",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT_NAME": "test",
        "SITE_ORIGIN": "https://test.shytalk.app",
        "GOOGLE_CLIENT_IDS": "415977447751-nu1hom2nn6dlg15gdh02de1kl3rm3onj.apps.googleusercontent.com,415977447751-s5v065q1pv58mjqp12bmosknv2g96ak1.apps.googleusercontent.com",
        "APPLE_AUDIENCES": "com.shyden.shytalk"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shytalk-test",
          "migrations_dir": "../../migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "SIGN_IN_LIMIT",
          "namespace_id": "1002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    },
    "dev": {
      "name": "shytalk-dev",
      "account_id": "6a27c9ff4b4eefef2c46535449ea4f49",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT_NAME": "dev",
        "SITE_ORIGIN": "https://dev.shytalk.app",
        "GOOGLE_CLIENT_IDS": "415977447751-nu1hom2nn6dlg15gdh02de1kl3rm3onj.apps.googleusercontent.com,415977447751-s5v065q1pv58mjqp12bmosknv2g96ak1.apps.googleusercontent.com",
        "APPLE_AUDIENCES": "com.shyden.shytalk"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shytalk-dev",
          "migrations_dir": "../../migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "SIGN_IN_LIMIT",
          "namespace_id": "1003",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  }
}
