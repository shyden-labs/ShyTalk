#!/usr/bin/env bash
# The static checks before every push (issues shyden-labs/repo-template#61, shyden-labs/repo-template#65): format, lint and
# typecheck on each commit being pushed, each in its own temporary worktree, so
# an error committed under a fixed working tree, or in an earlier commit of the
# push, is refused. scripts/pre-push.ts reads git's updates from stdin. No test
# suite runs here (global rule 2026-10-12): run the unit suite by hand before
# each push; every suite runs in CI on the pull request.
# `npm install` installs this hook: the `prepare` script points git's
# core.hooksPath at .githooks.
set -euo pipefail

exec node scripts/pre-push.ts "$@"
